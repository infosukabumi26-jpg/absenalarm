<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:padding="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_alarm"
                app:tint="@color/primary"
                android:contentDescription="Alarm icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ABSEN ALARM"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- CARD: Alarm Masuk -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header + Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/alarm_masuk"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginStart="12dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMasuk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Waktu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waktu:"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTimeMasuk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="07:30"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:gravity="center"
                        android:fontFamily="monospace" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimeMasuk"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="SET"
                        android:textSize="12sp"
                        app:cornerRadius="20dp" />
                </LinearLayout>

                <!-- Hari -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pilih_hari"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMasuk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="false"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMasukSen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/senin"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMasukSel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/selasa"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMasukRab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rabu"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMasukKam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kamis"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMasukJum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jumat"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMasukSab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sabtu"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="false" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMasukMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/minggu"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="false" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Ringtone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nada:"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRingtoneMasuk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nada_default"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRingtoneMasuk"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="🔔 PILIH"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        app:cornerRadius="20dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD: Alarm Pulang -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header + Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/alarm_pulang"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginStart="12dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPulang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Waktu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waktu:"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTimePulang"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="16:00"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:gravity="center"
                        android:fontFamily="monospace" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTimePulang"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="SET"
                        android:textSize="12sp"
                        app:cornerRadius="20dp" />
                </LinearLayout>

                <!-- Hari -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pilih_hari"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPulang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="false"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPulangSen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/senin"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPulangSel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/selasa"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPulangRab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rabu"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPulangKam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kamis"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPulangJum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jumat"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPulangSab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sabtu"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="false" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPulangMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/minggu"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:checked="false" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Ringtone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nada:"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRingtonePulang"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nada_default"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRingtonePulang"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="🔔 PILIH"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        app:cornerRadius="20dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD: URL Setting -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="@color/green_active" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="URL HALAMAN ABSEN"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/url_absen"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/default_url"
                        android:textSize="13sp"
                        android:inputType="textUri"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status Info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1B3A1B"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 STATUS ALARM"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_active"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvStatusMasuk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alarm Masuk: Nonaktif"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvStatusPulang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alarm Pulang: Nonaktif"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="💾 SIMPAN PENGATURAN"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>

